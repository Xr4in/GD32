# ============================================
# Keil MDK / ARM 工程 .gitignore
# ============================================

# ---------- Keil 编译输出目录 ----------
Objects/
Listings/
Output/
DebugConfig/
RTE/

# ---------- 编译中间件与产物 ----------
*.o
*.obj
*.d
*.crf
*.axf
*.elf
*.bin
*.hex
*.s19
*.map
*.lst
*.lnp
*.dep
*.iex
*.sct
*.htm
*.build_log.htm
*.l1p
*.l2p
*.__i
*._ii

# ---------- Keil 用户界面/本地配置（每人不同，不入库） ----------
*.uvguix.*
*.uvgui.*
*.uvopt.bak
*.uvproj.bak
*.uvprojx.bak
*.bak
*.scvd

# ---------- 调试器/J-Link 日志 ----------
JLinkLog.txt
JLinkSettings.ini
*.log
*.jlink
*.ini.bak

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
.cache/
.DS_Store
Thumbs.db
desktop.ini
*~

# ============================================
# 说明：以下文件有意保留入库
#   *.uvprojx  工程文件（器件、源文件列表、编译选项）
#   *.uvoptx   目标选项（调试器类型、Flash 算法、断点）
#   APP/  BSP/ 源代码
# ============================================
